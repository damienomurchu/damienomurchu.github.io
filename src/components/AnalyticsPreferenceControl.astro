<section
  class="not-prose border-border mt-12 border-t pt-8"
  aria-labelledby="analytics-preference-heading"
  data-analytics-preference-control
>
  <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
    <div class="max-w-xl">
      <h2
        id="analytics-preference-heading"
        class="font-prose text-foreground text-[1.7rem] leading-tight font-semibold tracking-tight"
      >
        Analytics preference
      </h2>
      <p class="text-foreground/90 mt-3 leading-relaxed">
        Forged uses self-hosted, privacy-focused analytics to understand
        aggregate site usage. There is no advertising or cross-site tracking.
        This setting applies to this browser and device, and you can change it
        at any time.
      </p>
      <p
        class="text-muted-foreground mt-3 text-sm"
        aria-live="polite"
        data-analytics-preference-status
      >
        Checking analytics preference…
      </p>
    </div>
    <button
      type="button"
      class="border-border text-foreground hover:border-accent hover:text-accent focus-outline min-w-fit border px-4 py-2 text-sm font-semibold transition-colors disabled:cursor-not-allowed disabled:opacity-60"
      disabled
      data-analytics-preference-button
    >
      Loading…
    </button>
  </div>
</section>
