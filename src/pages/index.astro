---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import PaperCard from "@/components/PaperCard.astro";
import LabNoteCard from "@/components/LabNoteCard.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getSeriesMap } from "@/utils/getSeries";
import { getSortedPapers } from "@/utils/papers";
import { getSortedLabNotes } from "@/utils/labNotes";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const seriesById = getSeriesMap(sortedPosts);
const papers = getSortedPapers(await getCollection("papers"));
const sortedLabNotes = getSortedLabNotes(await getCollection("labNotes"));
const selectedEssays = sortedPosts
  .filter(({ data }) => data.featured)
  .slice(0, 3);
const selectedPapers = papers.filter(({ data }) => data.featured).slice(0, 2);
const selectedLabNotes = sortedLabNotes
  .filter(({ data }) => data.featured)
  .slice(0, 2);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section id="hero" class="border-border border-b pt-2 pb-4">
      <h2
        class="font-prose mt-1 mb-3 inline-block text-4xl leading-tight font-bold tracking-tight sm:mb-4 sm:text-5xl"
      >
        Forged
      </h2>
      <div class="font-prose max-w-[75ch] text-lg">
        <p class="text-foreground/90 leading-relaxed font-normal">
          Exploring how systems are built, where they break, and what makes them
          endure.
        </p>
        <p class="text-foreground/65 mt-2 text-base leading-relaxed">
          {config.site.description}
        </p>
      </div>
    </section>

    {
      selectedEssays.length > 0 && (
        <section
          id="recent-posts"
          class:list={[
            "pt-3 pb-5",
            {
              "border-border border-b":
                selectedPapers.length > 0 || selectedLabNotes.length > 0,
            },
          ]}
        >
          <div class="flex items-baseline justify-between gap-4">
            <h2 class="font-prose text-2xl font-semibold tracking-tight">
              {t.home.recentPosts}
            </h2>
            <LinkButton
              href={getRelativeLocaleUrl(locale, "posts")}
              class="shrink-0 text-sm sm:text-base"
            >
              {t.home.allPosts}
              <IconArrowRight class="inline-block rtl:-rotate-180" />
            </LinkButton>
          </div>
          <ul>
            {selectedEssays.map(data => (
              <Card
                variant="h3"
                compact
                {...data}
                seriesTitle={
                  data.data.series
                    ? seriesById.get(data.data.series.id)?.title
                    : undefined
                }
              />
            ))}
          </ul>
        </section>
      )
    }

    {
      selectedPapers.length > 0 && (
        <section
          id="latest-papers"
          class:list={[
            "pt-3 pb-5",
            { "border-border border-b": selectedLabNotes.length > 0 },
          ]}
        >
          <div class="flex items-baseline justify-between gap-4">
            <h2 class="font-prose text-2xl font-semibold tracking-tight">
              {t.home.papers}
            </h2>
            <LinkButton
              href={getRelativeLocaleUrl(locale, "papers")}
              class="shrink-0 text-sm sm:text-base"
            >
              {t.home.allPapers}
              <IconArrowRight class="inline-block rtl:-rotate-180" />
            </LinkButton>
          </div>
          <ul class="mt-2">
            {selectedPapers.map(paper => (
              <PaperCard {...paper} compact />
            ))}
          </ul>
        </section>
      )
    }

    {
      selectedLabNotes.length > 0 && (
        <section id="lab-notes" class="pt-3 pb-5">
          <div class="flex items-baseline justify-between gap-4">
            <h2 class="font-prose text-2xl font-semibold tracking-tight">
              {t.home.labNotes}
            </h2>
            <LinkButton
              href={getRelativeLocaleUrl(locale, "lab-notes")}
              class="shrink-0 text-sm sm:text-base"
            >
              {t.home.allLabNotes}
              <IconArrowRight class="inline-block rtl:-rotate-180" />
            </LinkButton>
          </div>
          <ul class="mt-2">
            {selectedLabNotes.map(entry => (
              <LabNoteCard {...entry} compact />
            ))}
          </ul>
        </section>
      )
    }
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
