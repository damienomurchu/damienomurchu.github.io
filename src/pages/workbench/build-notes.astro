---
import { getCollection } from "astro:content";
import WorkbenchCategoryPage from "@/components/WorkbenchCategoryPage.astro";
import { getWorkbenchCategoryEntries } from "@/utils/workbench";

const entries = getWorkbenchCategoryEntries(
  await getCollection("workbench"),
  "build-note"
);
---

<WorkbenchCategoryPage category="build-note" {entries} />
