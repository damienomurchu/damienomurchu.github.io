---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import PaperCard from "@/components/PaperCard.astro";
import WorkbenchCard from "@/components/WorkbenchCard.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getSeriesMap } from "@/utils/getSeries";
import { getSortedPapers } from "@/utils/papers";
import { slugifyStr } from "@/utils/slugify";
import {
  getWorkbenchCategoryEntries,
  workbenchCategories,
} from "@/utils/workbench";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const seriesById = getSeriesMap(sortedPosts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const latestWriting = recentPosts.slice(0, 4);
const latestPapers = getSortedPapers(await getCollection("papers")).slice(0, 2);
const workbenchEntries = await getCollection("workbench");
const selectedWorkbenchEntries = workbenchCategories.flatMap(category =>
  getWorkbenchCategoryEntries(workbenchEntries, category.id).slice(0, 1)
);
const homePath = getRelativeLocaleUrl(locale, "");
const heroTopics = [
  "Engineering",
  "Personal Systems",
  "Work & Organisations",
  "Resilience",
  "Tools & Automation",
];
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section id="hero" class="border-border border-b pt-3 pb-6">
      <h2
        class="font-prose mt-2 mb-4 inline-block text-4xl leading-tight font-bold tracking-tight sm:mb-5 sm:text-5xl"
      >
        Forged
      </h2>
      <p
        class="font-prose text-foreground/90 max-w-[75ch] text-lg leading-relaxed font-normal"
      >
        {config.site.description}
      </p>
      <p class="mt-4 flex flex-wrap gap-x-2 gap-y-1 text-sm">
        {
          heroTopics.map((topic, index) => (
            <>
              {index > 0 && <span aria-hidden="true">·</span>}
              <a
                href={getRelativeLocaleUrl(
                  locale,
                  `tags/${slugifyStr(topic)}/`
                )}
                class="hover:text-accent focus-visible:text-accent underline-offset-4 hover:underline focus-visible:underline focus-visible:outline-none"
              >
                {topic}
              </a>
            </>
          ))
        }
      </p>
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-8 pb-6",
            {
              "border-border border-b":
                latestWriting.length > 0 ||
                latestPapers.length > 0 ||
                selectedWorkbenchEntries.length > 0,
            },
          ]}
        >
          <h2 class="font-prose text-2xl font-semibold tracking-tight">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card
                variant="h3"
                {...data}
                seriesTitle={
                  data.data.series
                    ? seriesById.get(data.data.series.id)?.title
                    : undefined
                }
              />
            ))}
          </ul>
        </section>
      )
    }

    {
      latestWriting.length > 0 && (
        <section
          id="recent-posts"
          class:list={[
            "pt-8 pb-6",
            {
              "border-border border-b":
                latestPapers.length > 0 || selectedWorkbenchEntries.length > 0,
            },
          ]}
        >
          <h2 class="font-prose text-2xl font-semibold tracking-tight">
            {t.home.recentPosts}
          </h2>
          <ul>
            {latestWriting.map(data => (
              <Card
                variant="h3"
                {...data}
                seriesTitle={
                  data.data.series
                    ? seriesById.get(data.data.series.id)?.title
                    : undefined
                }
              />
            ))}
          </ul>
          <div class="mt-4 text-end">
            <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
              {t.home.allPosts}
              <IconArrowRight class="inline-block rtl:-rotate-180" />
            </LinkButton>
          </div>
        </section>
      )
    }

    {
      latestPapers.length > 0 && (
        <section
          id="latest-papers"
          class:list={[
            "pt-8 pb-6",
            { "border-border border-b": selectedWorkbenchEntries.length > 0 },
          ]}
        >
          <h2 class="font-prose text-2xl font-semibold tracking-tight">
            {t.home.papers}
          </h2>
          <ul class="mt-2">
            {latestPapers.map(paper => (
              <PaperCard {...paper} compact />
            ))}
          </ul>
          <div class="mt-4 text-end">
            <LinkButton href={getRelativeLocaleUrl(locale, "papers")}>
              {t.home.allPapers}
              <IconArrowRight class="inline-block rtl:-rotate-180" />
            </LinkButton>
          </div>
        </section>
      )
    }

    {
      selectedWorkbenchEntries.length > 0 && (
        <section id="from-the-workbench" class="pt-8 pb-6">
          <h2 class="font-prose text-2xl font-semibold tracking-tight">
            {t.home.workbench}
          </h2>
          <ul class="mt-2">
            {selectedWorkbenchEntries.map(entry => (
              <WorkbenchCard {...entry} compact />
            ))}
          </ul>
          <div class="mt-4 text-end">
            <LinkButton href={getRelativeLocaleUrl(locale, "workbench")}>
              {t.home.allWorkbench}
              <IconArrowRight class="inline-block rtl:-rotate-180" />
            </LinkButton>
          </div>
        </section>
      )
    }
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
