---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import WorkbenchCard from "@/components/WorkbenchCard.astro";
import { useTranslations } from "@/i18n";
import {
  getWorkbenchCategoryEntries,
  workbenchCategories,
} from "@/utils/workbench";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const entries = await getCollection("workbench");
const previewLimit = 3;
---

<Layout
  title={`${t.pages.workbenchTitle} | ${config.site.title}`}
  description={t.pages.workbenchDesc}
>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.workbenchTitle} pageDesc={t.pages.workbenchDesc}>
    <div class="space-y-10">
      {
        workbenchCategories.map(category => {
          const categoryEntries = getWorkbenchCategoryEntries(
            entries,
            category.id
          );
          const previewEntries = categoryEntries.slice(0, previewLimit);

          return (
            <section aria-labelledby={`${category.id}-heading`}>
              <div class="border-border flex items-end justify-between gap-4 border-b pb-3">
                <div>
                  <h2
                    id={`${category.id}-heading`}
                    class="font-prose text-xl font-semibold tracking-tight"
                  >
                    {category.label}
                  </h2>
                  <p class="text-muted-foreground mt-1 leading-relaxed">
                    {category.description}
                  </p>
                </div>
                <span class="text-muted-foreground shrink-0 text-xs">
                  {categoryEntries.length}{" "}
                  {categoryEntries.length === 1 ? "entry" : "entries"}
                </span>
              </div>
              {categoryEntries.length > 0 ? (
                <ul class="mt-2">
                  {previewEntries.map(entry => (
                    <WorkbenchCard {...entry} />
                  ))}
                </ul>
              ) : (
                <p class="text-muted-foreground py-5 text-sm">
                  No published entries yet.
                </p>
              )}
              {categoryEntries.length > previewLimit && (
                <div class="mt-2 text-end">
                  <a
                    href={getRelativeLocaleUrl(
                      locale,
                      `workbench/${category.path}`
                    )}
                    class="hover:text-accent focus-outline inline-flex items-center gap-1 py-2 text-sm"
                  >
                    View all {category.label.toLowerCase()}
                    <IconArrowRight class="size-4 rtl:-rotate-180" />
                  </a>
                </div>
              )}
            </section>
          );
        })
      }
    </div>
  </Main>

  <Footer />
</Layout>
