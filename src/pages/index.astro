---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import PaperCard from "@/components/PaperCard.astro";
import WorkbenchCard from "@/components/WorkbenchCard.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getSeriesMap } from "@/utils/getSeries";
import { getSortedPapers } from "@/utils/papers";
import { slugifyStr } from "@/utils/slugify";
import {
  getWorkbenchCategoryEntries,
  workbenchCategories,
} from "@/utils/workbench";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const seriesById = getSeriesMap(sortedPosts);
const papers = getSortedPapers(await getCollection("papers"));
const workbenchEntries = await getCollection("workbench");
const sortedWorkbenchEntries = workbenchCategories.flatMap(category =>
  getWorkbenchCategoryEntries(workbenchEntries, category.id)
);
const selectedWork = [
  ...sortedPosts
    .filter(({ data }) => data.featured)
    .map(entry => ({ kind: "essay" as const, entry })),
  ...papers
    .filter(({ data }) => data.featured)
    .map(entry => ({ kind: "paper" as const, entry })),
  ...sortedWorkbenchEntries
    .filter(({ data }) => data.featured)
    .map(entry => ({ kind: "lab-note" as const, entry })),
]
  .toSorted((a, b) => {
    const aDate = a.entry.data.modDate ?? a.entry.data.pubDate;
    const bDate = b.entry.data.modDate ?? b.entry.data.pubDate;
    return bDate.getTime() - aDate.getTime();
  })
  .slice(0, 3);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const latestWriting = recentPosts.slice(0, 4);
const latestPapers = papers.filter(({ data }) => !data.featured).slice(0, 2);
const selectedWorkbenchEntries = workbenchCategories.flatMap(category =>
  getWorkbenchCategoryEntries(workbenchEntries, category.id)
    .filter(({ data }) => !data.featured)
    .slice(0, 1)
);
const homePath = getRelativeLocaleUrl(locale, "");
const heroTopics = [
  "Engineering",
  "Personal Systems",
  "Work & Organisations",
  "Resilience",
  "Tools & Automation",
];
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section id="hero" class="border-border border-b pt-3 pb-6">
      <h2
        class="font-prose mt-2 mb-4 inline-block text-4xl leading-tight font-bold tracking-tight sm:mb-5 sm:text-5xl"
      >
        Forged
      </h2>
      <p
        class="font-prose text-foreground/90 max-w-[75ch] text-lg leading-relaxed font-normal"
      >
        {config.site.description}
      </p>
      <p class="mt-4 flex flex-wrap gap-x-2 gap-y-1 text-sm">
        {
          heroTopics.map((topic, index) => (
            <>
              {index > 0 && <span aria-hidden="true">·</span>}
              <a
                href={getRelativeLocaleUrl(
                  locale,
                  `tags/${slugifyStr(topic)}/`
                )}
                class="hover:text-accent focus-visible:text-accent underline-offset-4 hover:underline focus-visible:underline focus-visible:outline-none"
              >
                {topic}
              </a>
            </>
          ))
        }
      </p>
    </section>

    {
      selectedWork.length > 0 && (
        <section
          id="selected-work"
          class:list={[
            "pt-5 pb-6",
            {
              "border-border border-b":
                latestWriting.length > 0 ||
                latestPapers.length > 0 ||
                selectedWorkbenchEntries.length > 0,
            },
          ]}
        >
          <h2 class="font-prose text-2xl font-semibold tracking-tight">
            {t.home.selectedWork}
          </h2>
          <ul class="mt-3 grid gap-4 sm:grid-cols-2 sm:[&>li:first-child]:col-span-2">
            {selectedWork.map((item, index) => {
              const lead = index === 0;

              if (item.kind === "paper") {
                return <PaperCard {...item.entry} card {lead} />;
              }

              if (item.kind === "lab-note") {
                return <WorkbenchCard {...item.entry} card {lead} />;
              }

              return (
                <Card
                  variant="h3"
                  card
                  {lead}
                  {...item.entry}
                  seriesTitle={
                    item.entry.data.series
                      ? seriesById.get(item.entry.data.series.id)?.title
                      : undefined
                  }
                />
              );
            })}
          </ul>
        </section>
      )
    }

    {
      latestWriting.length > 0 && (
        <section
          id="recent-posts"
          class:list={[
            "pt-5 pb-5",
            {
              "border-border border-b":
                latestPapers.length > 0 || selectedWorkbenchEntries.length > 0,
            },
          ]}
        >
          <div class="flex items-baseline justify-between gap-4">
            <h2 class="font-prose text-2xl font-semibold tracking-tight">
              {t.home.recentPosts}
            </h2>
            <LinkButton
              href={getRelativeLocaleUrl(locale, "posts")}
              class="shrink-0 text-sm sm:text-base"
            >
              {t.home.allPosts}
              <IconArrowRight class="inline-block rtl:-rotate-180" />
            </LinkButton>
          </div>
          <ul>
            {latestWriting.map(data => (
              <Card
                variant="h3"
                compact
                {...data}
                seriesTitle={
                  data.data.series
                    ? seriesById.get(data.data.series.id)?.title
                    : undefined
                }
              />
            ))}
          </ul>
        </section>
      )
    }

    {
      latestPapers.length > 0 && (
        <section
          id="latest-papers"
          class:list={[
            "pt-3 pb-5",
            { "border-border border-b": selectedWorkbenchEntries.length > 0 },
          ]}
        >
          <div class="flex items-baseline justify-between gap-4">
            <h2 class="font-prose text-2xl font-semibold tracking-tight">
              {t.home.papers}
            </h2>
            <LinkButton
              href={getRelativeLocaleUrl(locale, "papers")}
              class="shrink-0 text-sm sm:text-base"
            >
              {t.home.allPapers}
              <IconArrowRight class="inline-block rtl:-rotate-180" />
            </LinkButton>
          </div>
          <ul class="mt-2">
            {latestPapers.map(paper => (
              <PaperCard {...paper} compact />
            ))}
          </ul>
        </section>
      )
    }

    {
      selectedWorkbenchEntries.length > 0 && (
        <section id="from-the-workbench" class="pt-3 pb-5">
          <div class="flex items-baseline justify-between gap-4">
            <h2 class="font-prose text-2xl font-semibold tracking-tight">
              {t.home.workbench}
            </h2>
            <LinkButton
              href={getRelativeLocaleUrl(locale, "workbench")}
              class="shrink-0 text-sm sm:text-base"
            >
              {t.home.allWorkbench}
              <IconArrowRight class="inline-block rtl:-rotate-180" />
            </LinkButton>
          </div>
          <ul class="mt-2">
            {selectedWorkbenchEntries.map(entry => (
              <WorkbenchCard {...entry} compact />
            ))}
          </ul>
        </section>
      )
    }
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
