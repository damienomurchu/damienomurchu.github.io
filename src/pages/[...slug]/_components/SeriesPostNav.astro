---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import type { Series } from "@/utils/getSeries";
import { getPostUrl } from "@/utils/getPostPaths";
import config from "@/config";

type Props = {
  series: Series;
  currentPostId: string;
};

const { series, currentPostId } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const currentIndex = series.posts.findIndex(post => post.id === currentPostId);
const currentOrder =
  currentIndex >= 0
    ? series.posts[currentIndex].data.series!.order
    : currentIndex + 1;
const previousPost =
  currentIndex > 0 ? series.posts[currentIndex - 1] : undefined;
const nextPost =
  currentIndex >= 0 && currentIndex < series.posts.length - 1
    ? series.posts[currentIndex + 1]
    : undefined;
---

<section data-pagefind-ignore class="border-border my-8 border-y py-5">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <p
        class="text-muted-foreground text-xs font-medium tracking-[0.12em] uppercase"
      >
        {series.complete ? "Complete series" : "Ongoing series"}
      </p>
      <a
        href={getRelativeLocaleUrl(locale, `series/${series.id}/`)}
        class="font-prose text-accent mt-1 inline-block text-lg font-semibold decoration-dashed underline-offset-4 hover:underline"
      >
        {series.title}
      </a>
    </div>
    <span class="text-muted-foreground text-sm">
      Part {currentOrder} · {series.posts.length} published
    </span>
  </div>

  {
    (previousPost || nextPost) && (
      <div class="mt-5 grid grid-cols-1 gap-6 sm:grid-cols-2">
        {previousPost && (
          <a
            href={getPostUrl(
              previousPost.id,
              previousPost.filePath,
              locale,
              previousPost.data.slug
            )}
            class="group flex items-start gap-2"
          >
            <IconArrowLeft class="mt-0.5 size-4 flex-none rtl:rotate-180" />
            <span>
              <span class="text-muted-foreground block text-xs uppercase">
                Previous part
              </span>
              <span class="font-prose text-accent group-hover:underline">
                {previousPost.data.title}
              </span>
            </span>
          </a>
        )}
        {nextPost && (
          <a
            href={getPostUrl(
              nextPost.id,
              nextPost.filePath,
              locale,
              nextPost.data.slug
            )}
            class="group flex items-start justify-end gap-2 text-end sm:col-start-2"
          >
            <span>
              <span class="text-muted-foreground block text-xs uppercase">
                Next part
              </span>
              <span class="font-prose text-accent group-hover:underline">
                {nextPost.data.title}
              </span>
            </span>
            <IconArrowRight class="mt-0.5 size-4 flex-none rtl:rotate-180" />
          </a>
        )}
      </div>
    )
  }
</section>
