---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import Datetime from "./Datetime.astro";
import ReadingTime from "./ReadingTime.astro";

type Props = {
  variant?: "h2" | "h3";
  seriesTitle?: string;
  card?: boolean;
  lead?: boolean;
  compact?: boolean;
} & CollectionEntry<"posts">;

const {
  variant: Heading = "h2",
  seriesTitle,
  card = false,
  lead = false,
  compact = false,
  id,
  data,
  filePath,
  body,
} = Astro.props;

const { title, description, ...props } = data;
const displayDescription =
  card && data.series && seriesTitle
    ? `${seriesTitle} · Part ${data.series.order}`
    : description;
---

<li class:list={{ "my-3": !card && !compact, "my-1": compact, "h-full": card }}>
  <a
    href={getPostUrl(id, filePath, Astro.currentLocale, data.slug)}
    class:list={[
      "group block rounded",
      "hover:bg-muted/50 focus-visible:bg-muted/50 focus-visible:outline-muted-foreground focus-visible:outline-2 focus-visible:outline-offset-2",
      {
        "-mx-3 px-3": !card,
        "flex h-full flex-col": card,
        "border-border/70 bg-muted/10 border sm:min-h-[120px]": card && !lead,
        "border-border/80 border-l-accent bg-muted/20 border border-l-2 px-5 py-3.5":
          lead,
        "px-3 py-3": !lead && !compact,
        "px-3 py-2": compact,
      },
    ]}
  >
    {
      card && (
        <p class="text-muted-foreground mb-1 text-xs font-medium tracking-[0.1em] uppercase">
          Essay
        </p>
      )
    }
    {
      data.series && seriesTitle && !card && (
        <p class="text-muted-foreground mb-1 text-xs font-medium tracking-[0.1em] uppercase">
          {seriesTitle} · Part {data.series.order}
        </p>
      )
    }
    <Heading
      class:list={[
        "font-prose text-accent leading-tight font-semibold tracking-tight",
        {
          "text-xl": lead,
          "text-base": card && !lead,
          "text-lg": !card && !lead,
        },
      ]}
      transition:name={toTransitionName(title)}
    >
      {title}
    </Heading>
    <div
      class:list={[
        "flex flex-wrap items-center gap-x-2",
        { "mt-1": !card || lead, "mt-auto pt-3": card && !lead },
      ]}
    >
      <Datetime {...props} />
      <span aria-hidden="true" class="text-muted-foreground">·</span>
      <ReadingTime {body} />
      {
        data.tags.length > 0 && (
          <>
            <span aria-hidden="true" class="text-muted-foreground">
              ·
            </span>
            <span
              class="text-muted-foreground flex flex-wrap gap-x-2 text-sm"
              aria-label={`Topics: ${data.tags.join(", ")}`}
            >
              {data.tags.map(tag => (
                <span aria-hidden="true">#{tag}</span>
              ))}
            </span>
          </>
        )
      }
    </div>
    {
      !compact && (!card || lead) && (
        <p
          class:list={[
            "font-prose text-muted-foreground mt-1 text-base leading-relaxed font-normal",
            {
              "max-w-[70ch]": lead,
              "text-[0.95rem]": card && !lead,
              "line-clamp-2": card && !lead,
            },
          ]}
        >
          {displayDescription}
        </p>
      )
    }
  </a>
</li>
