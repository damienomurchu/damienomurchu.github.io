<section
  class="not-prose border-border mt-12 border-t pt-8"
  aria-labelledby="analytics-preference-heading"
  data-analytics-preference-control
>
  <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
    <div class="max-w-xl">
      <h2
        id="analytics-preference-heading"
        class="font-prose text-foreground text-[1.7rem] leading-tight font-semibold tracking-tight"
      >
        Analytics preference
      </h2>
      <p class="text-foreground/90 mt-3 leading-relaxed">
        Forged uses self-hosted, privacy-focused analytics to understand
        aggregate site usage. There is no advertising or cross-site tracking.
        This setting applies to this browser and device, and you can change it
        at any time.
      </p>
      <p
        class="text-muted-foreground mt-3 text-sm"
        aria-live="polite"
        data-analytics-preference-status
      >
        Checking analytics preference…
      </p>
    </div>
    <button
      type="button"
      class="border-border text-foreground hover:border-accent hover:text-accent focus-outline min-w-fit border px-4 py-2 text-sm font-semibold transition-colors disabled:cursor-wait disabled:opacity-60"
      disabled
      data-analytics-preference-button
    >
      Loading…
    </button>
  </div>
</section>

<script>
  import {
    ANALYTICS_PREFERENCE_EVENT,
    analyticsDisabled,
    toggleAnalytics,
    type AnalyticsPreference,
  } from "@/scripts/analyticsPreference";

  function reflectAnalyticsPreference(disabled = analyticsDisabled()): void {
    const control = document.querySelector<HTMLElement>(
      "[data-analytics-preference-control]"
    );
    const status = control?.querySelector<HTMLElement>(
      "[data-analytics-preference-status]"
    );
    const button = control?.querySelector<HTMLButtonElement>(
      "[data-analytics-preference-button]"
    );

    if (!status || !button) return;

    status.textContent = disabled ? "Analytics disabled" : "Analytics enabled";
    button.textContent = disabled ? "Re-enable analytics" : "Disable analytics";
    button.disabled = false;
  }

  function setupAnalyticsPreferenceControl(): void {
    reflectAnalyticsPreference();

    const button = document.querySelector<HTMLButtonElement>(
      "[data-analytics-preference-button]"
    );
    if (!button || button.dataset.preferenceBound === "true") return;

    button.dataset.preferenceBound = "true";
    button.addEventListener("click", () => toggleAnalytics());
  }

  setupAnalyticsPreferenceControl();
  document.addEventListener(
    "astro:after-swap",
    setupAnalyticsPreferenceControl
  );
  window.addEventListener(ANALYTICS_PREFERENCE_EVENT, event => {
    reflectAnalyticsPreference(
      (event as CustomEvent<AnalyticsPreference>).detail.disabled
    );
  });
</script>
