---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import Datetime from "./Datetime.astro";
import ReadingTime from "./ReadingTime.astro";

type Props = {
  variant?: "h2" | "h3";
  seriesTitle?: string;
  card?: boolean;
  compact?: boolean;
} & CollectionEntry<"posts">;

const {
  variant: Heading = "h2",
  seriesTitle,
  card = false,
  compact = false,
  id,
  data,
  filePath,
  body,
} = Astro.props;

const { title, description, ...props } = data;
const displayDescription =
  card && data.series && seriesTitle
    ? `${seriesTitle} · Part ${data.series.order}`
    : description;
---

<li class:list={{ "my-3": !card && !compact, "my-1": compact, "h-full": card }}>
  <a
    href={getPostUrl(id, filePath, Astro.currentLocale, data.slug)}
    class:list={[
      "group block rounded px-3",
      "hover:bg-muted/50 focus-visible:bg-muted/50",
      {
        "-mx-3": !card,
        "border-border bg-muted/20 h-full border": card,
        "py-3": !compact,
        "py-2": compact,
      },
    ]}
  >
    {
      data.series && seriesTitle && !card && (
        <p class="text-muted-foreground mb-1 text-xs font-medium tracking-[0.1em] uppercase">
          {seriesTitle} · Part {data.series.order}
        </p>
      )
    }
    <Heading
      class="font-prose text-accent text-lg leading-tight font-semibold tracking-tight"
      transition:name={toTransitionName(title)}
    >
      {title}
    </Heading>
    <div class="mt-1 flex flex-wrap items-center gap-x-2">
      <Datetime {...props} />
      <span aria-hidden="true" class="text-muted-foreground">·</span>
      <ReadingTime {body} />
      {
        data.tags.length > 0 && (
          <>
            <span aria-hidden="true" class="text-muted-foreground">
              ·
            </span>
            <span
              class="text-muted-foreground flex flex-wrap gap-x-2 text-sm"
              aria-label={`Topics: ${data.tags.join(", ")}`}
            >
              {data.tags.map(tag => (
                <span aria-hidden="true">#{tag}</span>
              ))}
            </span>
          </>
        )
      }
    </div>
    {
      !compact && (
        <p
          class:list={[
            "font-prose text-muted-foreground mt-1 text-base leading-relaxed font-normal",
            { "line-clamp-2": card },
          ]}
        >
          {displayDescription}
        </p>
      )
    }
  </a>
</li>
