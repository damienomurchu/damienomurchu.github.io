---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getSeries, type Series } from "@/utils/getSeries";
import config from "@/config";

export const getStaticPaths = (async () => {
  const posts = getSortedPosts(await getCollection("posts"));
  return getSeries(posts).map(series => ({
    params: { id: series.id },
    props: { series },
  }));
}) satisfies GetStaticPaths;

const { series } = Astro.props as { series: Series };
const status = series.complete ? "Complete" : "In progress";
---

<Layout
  title={`${series.title} | ${config.site.title}`}
  description={series.description}
>
  <Header />
  <Breadcrumb />
  <Main pageTitle={series.title}>
    <p
      class="font-prose text-muted-foreground -mt-1 max-w-[68ch] text-lg leading-relaxed"
    >
      {series.description}
    </p>
    <p class="text-muted-foreground mt-3 text-sm">
      {status} · {series.posts.length}
      {series.posts.length === 1 ? " part" : " parts"} published
    </p>
    <ol class="mt-8">
      {series.posts.map(post => <Card {...post} seriesTitle={series.title} />)}
    </ol>
  </Main>
  <Footer />
</Layout>
