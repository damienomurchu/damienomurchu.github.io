---
import type { CollectionEntry } from "astro:content";
import Datetime from "./Datetime.astro";
import ReadingTime from "./ReadingTime.astro";
import { getPaperUrl } from "@/utils/papers";

type Props = CollectionEntry<"papers"> & {
  compact?: boolean;
  card?: boolean;
  lead?: boolean;
};

const { compact = false, card = false, lead = false, ...paper } = Astro.props;
const { title, subtitle, description, pubDate, modDate, version, series } =
  paper.data;
---

<li class:list={{ "my-3": !card && !compact, "my-1": compact, "h-full": card }}>
  <a
    href={getPaperUrl(paper, Astro.currentLocale)}
    class:list={[
      "group block rounded",
      "hover:bg-muted/50 focus-visible:bg-muted/50",
      {
        "-mx-3 px-3": !card,
        "border-border/70 bg-muted/10 h-full border": card && !lead,
        "border-border/80 border-l-accent bg-muted/20 border border-l-2 px-5 py-4":
          lead,
        "px-3": !lead,
      },
      { "py-3": !lead && !compact, "py-2": compact },
    ]}
  >
    <p
      class="text-muted-foreground mb-1 text-xs font-medium tracking-[0.1em] uppercase"
    >
      {series ?? "Forged Papers"} · Version {version}
    </p>
    <h3
      class:list={[
        "font-prose text-accent leading-tight font-semibold tracking-tight",
        {
          "text-xl": lead,
          "text-[1.05rem]": card && !lead,
          "text-lg": !card && !lead,
        },
      ]}
    >
      {title}
    </h3>
    {
      !compact && (
        <p
          class:list={[
            "font-prose text-foreground/90 mt-0.5 leading-relaxed italic",
            { "text-[0.95rem]": card && !lead },
          ]}
        >
          {subtitle}
        </p>
      )
    }
    <div class="mt-1 flex flex-wrap items-center gap-x-2">
      <Datetime {pubDate} {modDate} />
      <span aria-hidden="true" class="text-muted-foreground">·</span>
      <ReadingTime body={paper.body} />
    </div>
    {
      !compact && (
        <p
          class:list={[
            "font-prose text-muted-foreground mt-2 text-base leading-relaxed",
            {
              "max-w-[70ch]": lead,
              "text-[0.95rem]": card && !lead,
              "line-clamp-2": card && !lead,
            },
          ]}
        >
          {description}
        </p>
      )
    }
  </a>
</li>
