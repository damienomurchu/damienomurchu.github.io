---
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Datetime from "./Datetime.astro";
import ReadingTime from "./ReadingTime.astro";
import { getWorkbenchCategory, getWorkbenchSlug } from "@/utils/workbench";
import { toTransitionName } from "@/utils/toTransitionName";
import config from "@/config";

type Props = {
  compact?: boolean;
  card?: boolean;
  lead?: boolean;
} & CollectionEntry<"workbench">;

const { compact = false, card = false, lead = false, ...entry } = Astro.props;
const { title, description, pubDate, modDate, category, status, tags, sample } =
  entry.data;
const categoryDetails = getWorkbenchCategory(category);
const locale = Astro.currentLocale ?? config.site.lang;
---

<li class:list={{ "my-3": !card && !compact, "my-1": compact, "h-full": card }}>
  <a
    href={getRelativeLocaleUrl(locale, `workbench/${getWorkbenchSlug(entry)}`)}
    class:list={[
      "group block rounded",
      "hover:bg-muted/50 focus-visible:bg-muted/50",
      {
        "-mx-3 px-3": !card,
        "border-border/70 bg-muted/10 h-full border": card && !lead,
        "border-border/80 border-l-accent bg-muted/20 border border-l-2 px-5 py-4":
          lead,
        "px-3": !lead,
      },
      { "py-3": !lead && !compact, "py-2": compact },
    ]}
  >
    <div
      class="text-muted-foreground mb-1 flex flex-wrap items-center gap-2 text-xs font-medium tracking-[0.1em] uppercase"
    >
      {card && <span>Lab Note</span>}
      {card && <span aria-hidden="true">·</span>}
      <span>{categoryDetails.singular}</span>
      <span aria-hidden="true">·</span>
      <span>{status}</span>
      {
        sample && (
          <span class="border-border rounded border px-1.5 py-0.5">Sample</span>
        )
      }
    </div>
    <h3
      class:list={[
        "font-prose text-accent leading-tight font-semibold tracking-tight",
        {
          "text-xl": lead,
          "text-[1.05rem]": card && !lead,
          "text-lg": !card && !lead,
        },
      ]}
      transition:name={toTransitionName(title)}
    >
      {title}
    </h3>
    <div class="mt-1 flex flex-wrap items-center gap-x-2">
      <Datetime {pubDate} {modDate} />
      {
        !compact && (
          <>
            <span aria-hidden="true" class="text-muted-foreground">
              ·
            </span>
            <ReadingTime body={entry.body} />
            {tags.length > 0 && (
              <>
                <span aria-hidden="true" class="text-muted-foreground">
                  ·
                </span>
                <span class="text-muted-foreground text-sm">
                  {tags.map(tag => `#${tag}`).join(" ")}
                </span>
              </>
            )}
          </>
        )
      }
    </div>
    {
      !compact && (!card || lead) && (
        <p
          class:list={[
            "font-prose text-muted-foreground mt-1 text-base leading-relaxed",
            {
              "max-w-[70ch]": lead,
              "text-[0.95rem]": card && !lead,
              "line-clamp-2": card && !lead,
            },
          ]}
        >
          {description}
        </p>
      )
    }
  </a>
</li>
