---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import type { Series } from "@/utils/getSeries";
import config from "@/config";

type Props = { series: Series };

const { series } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const partCount = series.posts.length;
---

<li>
  <a
    href={getRelativeLocaleUrl(locale, `series/${series.id}/`)}
    class="group border-border bg-muted/30 hover:border-accent hover:bg-muted/60 focus-visible:border-accent focus-visible:outline-accent block border px-5 py-5 transition duration-150 hover:-translate-y-px focus-visible:outline-2 focus-visible:outline-offset-2"
  >
    <div class="flex flex-wrap items-start justify-between gap-3">
      <h3
        class="font-prose group-hover:text-accent text-lg font-semibold tracking-tight"
      >
        {series.title}
      </h3>
      <span
        class="border-border text-muted-foreground border px-2 py-1 text-[0.6875rem] tracking-[0.12em] uppercase"
      >
        {series.complete ? "Complete" : "In progress"}
      </span>
    </div>
    <p
      class="font-prose text-muted-foreground mt-2 max-w-[64ch] leading-relaxed"
    >
      {series.description}
    </p>
    <div
      class="text-muted-foreground mt-4 flex items-center justify-between gap-4 text-xs"
    >
      <span>{partCount} {partCount === 1 ? "part" : "parts"} published</span>
      <span class="text-accent flex items-center gap-1">
        View series <IconArrowRight class="size-4 rtl:-rotate-180" />
      </span>
    </div>
  </a>
</li>
