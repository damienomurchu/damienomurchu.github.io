---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import LabNoteCard from "@/components/LabNoteCard.astro";
import { useTranslations } from "@/i18n";
import { getSortedLabNotes } from "@/utils/labNotes";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const entries = getSortedLabNotes(await getCollection("labNotes"));
---

<Layout
  title={`${t.pages.labNotesTitle} | ${config.site.title}`}
  description={t.pages.labNotesDesc}
>
  <Header />
  <Breadcrumb />

  <Main pageTitle={t.pages.labNotesTitle} pageDesc={t.pages.labNotesDesc}>
    <p
      class="text-muted-foreground border-border border-b pb-3 text-end text-xs"
    >
      {entries.length}
      {entries.length === 1 ? "entry" : "entries"}
    </p>
    {
      entries.length > 0 ? (
        <ul class="mt-2">
          {entries.map(entry => (
            <LabNoteCard {...entry} />
          ))}
        </ul>
      ) : (
        <p class="text-muted-foreground py-5 text-sm">
          No published entries yet.
        </p>
      )
    }
  </Main>

  <Footer />
</Layout>
