---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import SeriesCard from "@/components/SeriesCard.astro";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { getSeries } from "@/utils/getSeries";
import { postFilter } from "@/utils/postFilter";
import { useTranslations } from "@/i18n";
import config from "@/config";

const posts = await getCollection("posts", postFilter);
const tags = getUniqueTags(posts).filter(
  ({ postCount }) => postCount >= config.tags.minimumPosts
);
const series = getSeries(posts);

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.pages.tagsTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.tagsTitle} pageDesc={t.pages.tagsDesc}>
    {
      series.length > 0 && (
        <section aria-labelledby="series-heading" class="mb-10">
          <h2
            id="series-heading"
            class="font-prose mb-4 text-xl font-semibold tracking-tight"
          >
            Series
          </h2>
          <ul class="grid max-w-3xl grid-cols-1 gap-4">
            {series.map(item => (
              <SeriesCard series={item} />
            ))}
          </ul>
        </section>
      )
    }
    <section aria-labelledby="topics-heading">
      <h2
        id="topics-heading"
        class="font-prose mb-4 text-xl font-semibold tracking-tight"
      >
        Topics
      </h2>
      <ul class="grid max-w-3xl grid-cols-1 gap-3 sm:grid-cols-2">
        {
          tags.map(({ tag, tagName, postCount }) => (
            <Tag {tag} {tagName} {postCount} variant="directory" />
          ))
        }
      </ul>
    </section>
  </Main>

  <Footer />
</Layout>
