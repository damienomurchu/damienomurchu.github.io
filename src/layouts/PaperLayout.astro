---
import Layout from "./Layout.astro";
import config from "@/config";

type Props = {
  title: string;
  subtitle: string;
  description: string;
  canonicalURL?: string;
  pubDate: Date;
  modDate?: Date | null;
  version: string;
  status: "published" | "revised" | "superseded";
  tags: string[];
};

const {
  title,
  subtitle,
  description,
  canonicalURL,
  pubDate,
  modDate,
  version,
  status,
  tags,
} = Astro.props;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "ScholarlyArticle",
  headline: title,
  alternativeHeadline: subtitle,
  description,
  datePublished: pubDate.toISOString().slice(0, 10),
  ...(modDate && { dateModified: modDate.toISOString().slice(0, 10) }),
  version,
  keywords: tags,
  creativeWorkStatus: status,
  author: {
    "@type": "Person",
    name: config.site.author,
    ...(config.site.profile && { url: config.site.profile }),
  },
};
---

<Layout title={`${title} | ${config.site.title}`} {description} {canonicalURL}>
  <Fragment slot="head">
    <meta property="og:type" content="article" />
    <meta
      property="article:published_time"
      content={pubDate.toISOString().slice(0, 10)}
    />
    {
      modDate && (
        <meta
          property="article:modified_time"
          content={modDate.toISOString().slice(0, 10)}
        />
      )
    }
    {tags.map(tag => <meta property="article:tag" content={tag} />)}
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />
  </Fragment>

  <slot />
</Layout>
