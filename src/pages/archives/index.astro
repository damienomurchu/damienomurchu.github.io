---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import PaperCard from "@/components/PaperCard.astro";
import LabNoteCard from "@/components/LabNoteCard.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getSeriesMap } from "@/utils/getSeries";
import { getSortedPapers } from "@/utils/papers";
import { getSortedLabNotes } from "@/utils/labNotes";
import { getItemsByGroupCondition } from "./_utils/getPostsByGroupCondition";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;

// Redirect to 404 page if `showArchives` config is false
const notFoundUrl = getRelativeLocaleUrl(locale, "404");
if (!config.features.showArchives && notFoundUrl) {
  return Astro.rewrite(notFoundUrl);
}

const t = useTranslations(locale);

const posts = getSortedPosts(await getCollection("posts"));
const seriesById = getSeriesMap(posts);
const archiveItems = [
  ...posts.map(entry => ({ type: "essay" as const, entry })),
  ...getSortedPapers(await getCollection("papers")).map(entry => ({
    type: "paper" as const,
    entry,
  })),
  ...getSortedLabNotes(await getCollection("labNotes")).map(entry => ({
    type: "labNote" as const,
    entry,
  })),
];
const monthFormatter = new Intl.DateTimeFormat(locale, { month: "long" });
---

<Layout title={`${t.pages.archivesTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.archivesTitle} pageDesc={t.pages.archivesDesc}>
    {
      Object.entries(
        getItemsByGroupCondition(archiveItems, item =>
          item.entry.data.pubDate.getUTCFullYear()
        )
      )
        .sort(([yearA], [yearB]) => Number(yearB) - Number(yearA))
        .map(([year, yearGroup]) => (
          <div>
            <span class="text-2xl font-bold">{year}</span>
            <sup class="text-muted-foreground text-sm">{yearGroup.length}</sup>
            {Object.entries(
              getItemsByGroupCondition(
                yearGroup,
                item => item.entry.data.pubDate.getUTCMonth() + 1
              )
            )
              .sort(([monthA], [monthB]) => Number(monthB) - Number(monthA))
              .map(([month, monthGroup]) => (
                <div class="flex flex-col sm:flex-row">
                  <div class="mt-6 min-w-36 text-lg sm:my-6">
                    <span class="font-bold">
                      {monthFormatter.format(
                        new Date(2000, Number(month) - 1, 1)
                      )}
                    </span>
                    <sup class="text-muted-foreground text-xs">
                      {monthGroup.length}
                    </sup>
                  </div>
                  <ul>
                    {monthGroup
                      .sort(
                        (a, b) =>
                          Math.floor(
                            new Date(b.entry.data.pubDate).getTime() / 1000
                          ) -
                          Math.floor(
                            new Date(a.entry.data.pubDate).getTime() / 1000
                          )
                      )
                      .map(item =>
                        item.type === "essay" ? (
                          <Card
                            {...item.entry}
                            showType
                            seriesTitle={
                              item.entry.data.series
                                ? seriesById.get(item.entry.data.series.id)
                                    ?.title
                                : undefined
                            }
                          />
                        ) : item.type === "paper" ? (
                          <PaperCard {...item.entry} showType />
                        ) : (
                          <LabNoteCard {...item.entry} showType />
                        )
                      )}
                  </ul>
                </div>
              ))}
          </div>
        ))
    }
  </Main>

  <Footer />
</Layout>
